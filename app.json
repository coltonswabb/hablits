{
  "expo": {
    "name": "Hablits",
    "slug": "hablits",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Build better habits with your virtual pet companion. Track daily habits, create routines, and watch your pet grow as you stay consistent.",
    "privacy": "https://coltonswabb.github.io/hablits/",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hablits.app",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUbiquitousContainers": {
          "iCloud.com.hablits.app": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "Hablits",
            "NSUbiquitousContainerSupportedFolderLevels": "None"
          }
        }
      },
      "usesIcloudStorage": true,
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": [
          "iCloud.com.hablits.app"
        ],
        "com.apple.developer.icloud-services": [
          "CloudDocuments"
        ],
        "com.apple.developer.ubiquity-container-identifiers": [
          "iCloud.com.hablits.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.hablits.app",
      "versionCode": 1,
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "23115a03-2663-4d4b-a53f-86cdb5907761"
      }
    },
    "owner": "hablits",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/23115a03-2663-4d4b-a53f-86cdb5907761"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-pet.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/splash-pet.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#667eea"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.hablits.app",
          "widgets": [
            {
              "name": "HablitsToday",
              "displayName": "Today",
              "description": "Today's habits, your progress ring, and your streak — at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/TodayWidget.tsx"
              }
            }
          ],
          "frequentUpdates": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "White",
            "ios": "./assets/icons/white.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon.png",
              "backgroundColor": "#ffffff"
            }
          },
          {
            "name": "Violet",
            "ios": "./assets/icons/violet.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon.png",
              "backgroundColor": "#6c6fe0"
            }
          },
          {
            "name": "Mint",
            "ios": "./assets/icons/mint.png",
            "android": {
              "foregroundImage": "./assets/adaptive-icon.png",
              "backgroundColor": "#0f1320"
            }
          }
        ]
      ]
    ],
    "scheme": "hablits"
  }
}
